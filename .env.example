# Container deployment. Use matching, immutable release image references.
TIMEKEEPER_IMAGE=timekeeper:runtime-RELEASE
TIMEKEEPER_MIGRATION_IMAGE=timekeeper:migration-RELEASE
TIMEKEEPER_DATA_DIR=/srv/timekeeper/data
TIMEKEEPER_ORIGIN=https://timekeeper.example.com

# Host-side proxy target. The application port is published only on loopback.
TIMEKEEPER_PORT=3000
# Leave empty unless you have verified the literal immediate proxy peer address.
TIMEKEEPER_TRUSTED_PROXY_IPS=
