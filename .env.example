# Local development uses the loopback Vite origin with npm run dev:server.
# Set the public HTTPS origin when deploying with NODE_ENV=production.
# TIMEKEEPER_ORIGIN=https://timekeeper.example.com

# An absolute local file URL. Defaults to timekeeper.sqlite in the repository root.
# TIMEKEEPER_DATABASE_URL=file:/var/lib/timekeeper/timekeeper.sqlite

# Optional comma-separated literal IPs for immediate reverse proxy peers.
# TIMEKEEPER_TRUSTED_PROXY_IPS=127.0.0.1

# HOST=127.0.0.1
# PORT=3000
