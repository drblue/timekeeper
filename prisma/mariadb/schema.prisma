generator client {
  provider            = "prisma-client"
  output              = "../generated/mariadb"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

model FixtureProject {
  id      String             @id @db.VarChar(36)
  name    String             @db.VarChar(191)
  entries FixtureTimeEntry[]
}

model FixtureTimeEntry {
  id                     String                      @id @db.VarChar(36)
  projectId              String                      @db.VarChar(36)
  project                FixtureProject              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  description            String                      @db.LongText
  effectiveHourlyRateOre BigInt?
  billableAmountOre      BigInt
  startedAt              DateTime?                   @db.DateTime(0)
  workDate               String?                     @db.VarChar(10)
  allocations            FixtureEntryDayAllocation[]
}

model FixtureEntryDayAllocation {
  entryId   String           @db.VarChar(36)
  entry     FixtureTimeEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  localDate String           @db.VarChar(10)
  seconds   Int

  @@id([entryId, localDate])
}
