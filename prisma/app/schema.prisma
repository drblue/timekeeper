generator client {
  provider            = "prisma-client"
  output              = "../../apps/server/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id           String    @id
  ownerSlot    Int       @unique @default(1)
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  clients      Client[]
  projects     Project[]
  entries      Entry[]
}

model Session {
  tokenHash String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([accountId])
  @@index([expiresAt])
}

model Client {
	id                    String    @id
	accountId             String
	account               Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
	name                  String
	notes                 String?
	defaultRateOrePerHour BigInt?
	archivedAt            DateTime?
	revision              Int       @default(1)
	projects              Project[]
	entries               Entry[]

	@@unique([accountId, id])
	@@index([accountId, archivedAt])
}

model Project {
	id                     String    @id
	accountId              String
	account                Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
	clientId               String?
	client                 Client?   @relation(fields: [accountId, clientId], references: [accountId, id], onDelete: Restrict)
	name                   String
	notes                  String?
	rateOverrideOrePerHour BigInt?
	defaultBillable        Boolean   @default(true)
	archivedAt             DateTime?
	revision               Int       @default(1)
	entries                Entry[]

	@@unique([accountId, id])
	@@index([accountId, archivedAt])
	@@index([accountId, clientId])
}

model Entry {
	id                     String               @id
	accountId              String
	account                Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
	kind                   String
	description            String
	localDate              String
	durationSeconds        Int
	projectId              String?
	project                Project?             @relation(fields: [accountId, projectId], references: [accountId, id], onDelete: Restrict)
	directClientId         String?
	directClient           Client?              @relation(fields: [accountId, directClientId], references: [accountId, id], onDelete: Restrict)
	billable               Boolean
	assignedRateOrePerHour BigInt?
	billableAmountOre      BigInt
	revision               Int                  @default(1)
	createdAt              DateTime             @default(now())
	allocations            EntryDayAllocation[]

	@@index([accountId, localDate, createdAt])
	@@index([accountId, projectId])
	@@index([accountId, directClientId])
}

model EntryDayAllocation {
	entryId            String
	entry              Entry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
	localDate          String
	seconds            Int
	amountOre          BigInt
	calculationVersion Int

	@@id([entryId, localDate])
}
