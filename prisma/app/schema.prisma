generator client {
  provider            = "prisma-client"
  output              = "../../apps/server/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id           String    @id
  ownerSlot    Int       @unique @default(1)
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  clients      Client[]
  projects     Project[]
  entries      Entry[]
  runningTimer RunningTimer?
  operationReceipts OperationReceipt[]
  bulkEntryPreviews BulkEntryPreview[]
  reportSettings ReportSettings?
  reportJobs ReportJob[]
}

model Session {
  tokenHash String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([accountId])
  @@index([expiresAt])
}

model ReportSettings {
	accountId    String   @id
	account      Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
	businessName String?
	logoId       String?  @unique
	logoWidth    Int?
	logoHeight   Int?
	logoBytes    Bytes?
}

model ReportJob {
	id        String   @id
	accountId String
	account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
	status    String
	createdAt DateTime
	expiresAt DateTime?
	input     String?
	errorCode String?

	@@index([status, createdAt])
	@@index([expiresAt])
}

model Client {
	id                    String    @id
	accountId             String
	account               Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
	name                  String
	notes                 String?
	defaultRateOrePerHour BigInt?
	archivedAt            DateTime?
	revision              Int       @default(1)
	projects              Project[]
	entries               Entry[]
	timers                RunningTimer[]

	@@unique([accountId, id])
	@@index([accountId, archivedAt])
}

model Project {
	id                     String    @id
	accountId              String
	account                Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
	clientId               String?
	client                 Client?   @relation(fields: [accountId, clientId], references: [accountId, id], onDelete: Restrict)
	name                   String
	notes                  String?
	rateOverrideOrePerHour BigInt?
	defaultBillable        Boolean   @default(true)
	archivedAt             DateTime?
	revision               Int       @default(1)
	entries                Entry[]
	timers                 RunningTimer[]

	@@unique([accountId, id])
	@@index([accountId, archivedAt])
	@@index([accountId, clientId])
}

model Entry {
	id                     String               @id
	accountId              String
	account                Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
	kind                   String
	description            String
	localDate              String
	startAt                DateTime?
	endAt                  DateTime?
	durationSeconds        Int
	projectId              String?
	project                Project?             @relation(fields: [accountId, projectId], references: [accountId, id], onDelete: Restrict)
	directClientId         String?
	directClient           Client?              @relation(fields: [accountId, directClientId], references: [accountId, id], onDelete: Restrict)
	billable               Boolean
	assignedRateOrePerHour BigInt?
	billableAmountOre      BigInt?
	completion             String               @default("complete")
	invoicedAt             DateTime?
	invoiceNumber          String?
	invoiceDate            String?
	invoiceReference       String?
	deletedAt              DateTime?
	supersededAt           DateTime?
	splitFromEntryId       String?
	splitFrom              Entry?               @relation("EntrySplit", fields: [accountId, splitFromEntryId], references: [accountId, id], onDelete: Restrict)
	splitChildren          Entry[]              @relation("EntrySplit")
	revision               Int                  @default(1)
	createdAt              DateTime             @default(now())
	allocations            EntryDayAllocation[]
	history                EntryHistory[]

	@@index([accountId, localDate, createdAt])
	@@index([accountId, projectId])
	@@index([accountId, directClientId])
	@@index([accountId, startAt, endAt])
	@@index([accountId, invoicedAt])
	@@index([accountId, deletedAt])
	@@unique([accountId, id])
	@@index([accountId, splitFromEntryId])
}

model EntryDayAllocation {
	entryId            String
	entry              Entry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
	localDate          String
	seconds            Int
	amountOre          BigInt
	calculationVersion Int

	@@id([entryId, localDate])
	@@index([localDate, entryId])
}

model RunningTimer {
	accountId              String    @id
	account                Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
	id                     String    @unique
	startAt                DateTime
	description            String
	projectId              String?
	project                Project?  @relation(fields: [accountId, projectId], references: [accountId, id], onDelete: Restrict)
	directClientId         String?
	directClient           Client?   @relation(fields: [accountId, directClientId], references: [accountId, id], onDelete: Restrict)
	billable               Boolean
	assignedRateOrePerHour BigInt?
	revision               Int       @default(1)
}

model OperationReceipt {
	accountId      String
	account        Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
	key            String
	requestHash    String
	resultSnapshot String
	completedAt    DateTime

	@@id([accountId, key])
}

model BulkEntryPreview {
	id         String   @id
	accountId  String
	account    Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
	snapshot   String
	expiresAt  DateTime
	consumedAt DateTime?

	@@index([accountId, expiresAt])
}

model EntryHistory {
	id             String    @id
	entryId        String
	entry          Entry     @relation(fields: [entryId], references: [id], onDelete: Restrict)
	action         String
	at             DateTime
	beforeSnapshot String?
	afterSnapshot  String
	operationKey   String?

	@@index([entryId, at])
}
