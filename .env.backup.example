TIMEKEEPER_BACKUP_IMAGE=timekeeper:backup-RELEASE
TIMEKEEPER_DATA_DIR=/srv/timekeeper/data
TIMEKEEPER_BACKUP_DIR=/mnt/timekeeper-backup
TIMEKEEPER_BACKUP_DESTINATION_ID=replace-with-provisioned-destination-id
TIMEKEEPER_BACKUP_SCRATCH_DIR=/srv/timekeeper/backup-scratch
TIMEKEEPER_BACKUP_RECIPIENTS=/etc/timekeeper/backup-recipients
